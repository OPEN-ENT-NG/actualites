#!/usr/bin/env groovy

// Builds the frontend and its image on its own. It does not build the backend.
pipeline {
  agent any

  stages {
    stage('Initialization') {
      steps {
        sh './build.sh $BUILD_SH_EXTRA_PARAM init'
      }
    }

    stage('Frontend') {
      steps {
        dir('frontend') {
          sh './build.sh clean init build'
        }
      }
    }

    stage('Build image') {
      steps {
        sh './edifice image --archs=linux/amd64 --force --service=false --upgrader=false'
      }
    }
  }
}
